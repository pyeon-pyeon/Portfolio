{
  "contract_name": "플랜두씨 다이어리 데이터 구조",
  "schema_version": 2,
  "database": {
    "engine": "PostgreSQL",
    "provider": "Supabase",
    "schema": "public",
    "access": {
      "application": "Vercel 서버 API를 통한 조회·등록·수정·삭제",
      "authentication": "현재 로그인 없음",
      "browser_direct_access": false,
      "row_level_security": true,
      "server_environment_variables": [
        "SUPABASE_URL",
        "SUPABASE_SECRET_KEY"
      ],
      "secret_values_in_contract": false
    }
  },
  "tables": {
    "diary_plans": {
      "description": "계획과 돌아보기",
      "primary_key": ["id"],
      "columns": {
        "id": {
          "type": "uuid",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "plan_date": {
          "type": "date",
          "nullable": false,
          "description": "기존 코드 호환용 날짜. DB 트리거가 start_date와 같게 설정"
        },
        "start_date": {
          "type": "date",
          "nullable": false
        },
        "end_date": {
          "type": "date",
          "nullable": false
        },
        "title": {
          "type": "text",
          "nullable": false,
          "constraints": ["trimmed_length_between_1_and_100"]
        },
        "goal": {
          "type": "text",
          "nullable": false,
          "default": "",
          "max_length": 2000
        },
        "priority": {
          "type": "text",
          "nullable": false,
          "default": "medium",
          "allowed_values": ["high", "medium", "low"]
        },
        "success_criteria": {
          "type": "text",
          "nullable": false,
          "default": "",
          "max_length": 2000,
          "api_rule": "신규 등록과 이 항목 수정 시 공백만 있는 값은 거부",
          "legacy_rule": "기존 자료는 빈 문자열 허용"
        },
        "estimated_minutes": {
          "type": "integer",
          "nullable": false,
          "default": 0,
          "unit": "minute",
          "database_range": [0, 525600],
          "api_input_range": [1, 525600],
          "description": "계획 전체 예상 시간. 할 일 예상 합계와 별도로 저장"
        },
        "reflection": {
          "type": "text",
          "nullable": false,
          "default": "",
          "max_length": 4000
        },
        "next_action": {
          "type": "text",
          "nullable": false,
          "default": "",
          "max_length": 2000,
          "ui_rule": "돌아보기 저장 시 개선점 한 줄 입력"
        },
        "reviewed_at": {
          "type": "timestamp with time zone",
          "nullable": true,
          "description": "돌아보기 저장 API가 서버 시각으로 설정"
        },
        "previous_plan_id": {
          "type": "uuid",
          "nullable": true,
          "references": "public.diary_plans.id",
          "on_delete": "SET NULL",
          "constraints": ["must_not_equal_own_id"],
          "api_rule": "생성 시 지정하며 이후 다른 값으로 변경 불가"
        },
        "version": {
          "type": "integer",
          "nullable": false,
          "default": 1,
          "minimum": 1,
          "description": "DB 트리거가 관리하는 계획 버전"
        },
        "created_at": {
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()",
          "on_update": "DB 트리거에서 now() 설정"
        }
      },
      "constraints": [
        "end_date >= start_date"
      ],
      "indexes": [
        {
          "name": "diary_plans_date_idx",
          "columns": ["plan_date DESC", "created_at DESC"]
        },
        {
          "name": "diary_plans_previous_idx",
          "columns": ["previous_plan_id"]
        },
        {
          "name": "diary_plans_period_idx",
          "columns": ["start_date", "end_date"]
        }
      ],
      "server_role_permissions": [
        "SELECT",
        "INSERT",
        "UPDATE",
        "DELETE"
      ]
    },
    "diary_tasks": {
      "description": "계획에 연결된 할 일",
      "primary_key": ["id"],
      "columns": {
        "id": {
          "type": "uuid",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "plan_id": {
          "type": "uuid",
          "nullable": false,
          "references": "public.diary_plans.id",
          "on_delete": "CASCADE",
          "api_rule": "생성 후 다른 계획으로 이동 불가"
        },
        "title": {
          "type": "text",
          "nullable": false,
          "constraints": ["trimmed_length_between_1_and_200"]
        },
        "estimated_minutes": {
          "type": "integer",
          "nullable": false,
          "unit": "minute",
          "range": [1, 1440]
        },
        "status": {
          "type": "text",
          "nullable": false,
          "default": "todo",
          "allowed_values": [
            "todo",
            "doing",
            "done",
            "cancelled"
          ]
        },
        "sort_order": {
          "type": "integer",
          "nullable": false,
          "default": 0,
          "minimum": 0
        },
        "due_date": {
          "type": "date",
          "nullable": false,
          "description": "마감일의 KST 하루 끝까지 기한으로 해석"
        },
        "priority": {
          "type": "text",
          "nullable": false,
          "default": "medium",
          "allowed_values": ["high", "medium", "low"]
        },
        "tags": {
          "type": "text[]",
          "nullable": false,
          "default": [],
          "database_rules": [
            "최대 10개",
            "NULL 요소 금지"
          ],
          "api_rules": [
            "태그당 공백 제거 후 1~30자",
            "동일 문자열 중복 제거",
            "입력 배열 최대 10개"
          ]
        },
        "completed_at": {
          "type": "timestamp with time zone",
          "nullable": true,
          "description": "완료 상태 진입 시 DB가 기록. 기존 완료 기록은 시각 미기록 가능"
        },
        "created_at": {
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()",
          "on_update": "DB 트리거에서 now() 설정"
        }
      },
      "constraints": [
        "status가 done이 아니면 completed_at은 NULL"
      ],
      "indexes": [
        {
          "name": "diary_tasks_plan_idx",
          "columns": ["plan_id", "sort_order", "created_at"]
        },
        {
          "name": "diary_tasks_due_date_idx",
          "columns": ["due_date"]
        }
      ],
      "server_role_permissions": [
        "SELECT",
        "INSERT",
        "UPDATE",
        "DELETE"
      ]
    },
    "diary_logs": {
      "description": "할 일에 연결된 실제 실행 기록",
      "primary_key": ["id"],
      "columns": {
        "id": {
          "type": "uuid",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "task_id": {
          "type": "uuid",
          "nullable": false,
          "references": "public.diary_tasks.id",
          "on_delete": "CASCADE",
          "api_rule": "수정 시 같은 계획에 속한 할 일로만 이동 가능"
        },
        "performed_on": {
          "type": "date",
          "nullable": false,
          "description": "시작 시각의 KST 날짜. 기존 시각 없는 기록은 기존 날짜 유지"
        },
        "started_at": {
          "type": "timestamp with time zone",
          "nullable": true,
          "api_rule": "신규 기록에서는 필수",
          "legacy_rule": "기존 기록에 한해 ended_at과 함께 NULL 허용"
        },
        "ended_at": {
          "type": "timestamp with time zone",
          "nullable": true,
          "api_rule": "신규 기록에서는 필수",
          "legacy_rule": "기존 기록에 한해 started_at과 함께 NULL 허용"
        },
        "actual_minutes": {
          "type": "integer",
          "nullable": false,
          "unit": "minute",
          "range": [1, 1440],
          "description": "시각이 있는 기록은 DB 트리거가 계산"
        },
        "note": {
          "type": "text",
          "nullable": false,
          "default": "",
          "max_length": 2000
        },
        "blocked_reason": {
          "type": "text",
          "nullable": false,
          "default": "",
          "max_length": 2000
        },
        "client_request_id": {
          "type": "uuid",
          "nullable": false,
          "default": "gen_random_uuid()",
          "unique": true,
          "description": "신규 저장 요청의 중복 방지 키. API는 클라이언트가 보낸 키를 필수로 사용"
        },
        "created_at": {
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()"
        },
        "updated_at": {
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()",
          "on_update": "DB 트리거에서 now() 설정"
        }
      },
      "constraints": [
        "시작·종료 시각은 모두 NULL이거나 모두 존재",
        "시각이 있으면 ended_at > started_at",
        "시각이 있으면 실행 구간은 최대 24시간",
        "신규 INSERT에는 시작·종료 시각 필수",
        "한번 기록한 시작·종료 시각을 NULL로 제거 불가",
        "client_request_id는 테이블 전체에서 고유"
      ],
      "indexes": [
        {
          "name": "diary_logs_task_date_idx",
          "columns": ["task_id", "performed_on"]
        },
        {
          "name": "diary_logs_started_at_idx",
          "columns": ["started_at"]
        }
      ],
      "server_role_permissions": [
        "SELECT",
        "INSERT",
        "UPDATE",
        "DELETE"
      ]
    },
    "diary_plan_versions": {
      "description": "계획의 최초 보존본과 변경 이력",
      "primary_key": ["id"],
      "columns": {
        "id": {
          "type": "uuid",
          "nullable": false,
          "default": "gen_random_uuid()"
        },
        "plan_id": {
          "type": "uuid",
          "nullable": false,
          "references": "public.diary_plans.id",
          "on_delete": "CASCADE"
        },
        "version": {
          "type": "integer",
          "nullable": false,
          "minimum": 1
        },
        "snapshot": {
          "type": "jsonb",
          "nullable": false,
          "constraints": ["JSON object"],
          "description": "해당 버전의 diary_plans 전체 행"
        },
        "is_migration_baseline": {
          "type": "boolean",
          "nullable": false,
          "default": false,
          "description": "기존 계획의 확장 시점 보존본이면 true"
        },
        "recorded_at": {
          "type": "timestamp with time zone",
          "nullable": false,
          "default": "now()"
        }
      },
      "unique_constraints": [
        ["plan_id", "version"]
      ],
      "server_role_permissions": ["SELECT"],
      "write_rule": "계획 변경을 감지한 SECURITY DEFINER 트리거만 이력 추가"
    }
  },
  "relationships": [
    {
      "parent": "diary_plans.id",
      "child": "diary_tasks.plan_id",
      "cardinality": "one-to-many",
      "on_delete": "CASCADE"
    },
    {
      "parent": "diary_tasks.id",
      "child": "diary_logs.task_id",
      "cardinality": "one-to-many",
      "on_delete": "CASCADE"
    },
    {
      "parent": "diary_plans.id",
      "child": "diary_plan_versions.plan_id",
      "cardinality": "one-to-many",
      "on_delete": "CASCADE"
    },
    {
      "parent": "diary_plans.id",
      "child": "diary_plans.previous_plan_id",
      "cardinality": "one-to-many",
      "on_delete": "SET NULL",
      "description": "이전 돌아보기에서 이어지는 다음 계획"
    }
  ],
  "date_rules": {
    "display_timezone": "Asia/Seoul",
    "kst_offset": "+09:00",
    "date_format": "YYYY-MM-DD",
    "timestamp_storage": "timestamp with time zone",
    "api_timestamp_input": "시간대가 포함된 ISO 8601 문자열",
    "api_timestamp_normalization": "UTC ISO 8601 문자열",
    "datetime_local_interpretation": "컴퓨터 시간대와 무관하게 KST로 해석",
    "plan_period": "start_date와 end_date 양 끝 날짜 포함",
    "execution_date": "started_at을 KST로 변환한 날짜",
    "actual_minutes_formula": "ceil((ended_at - started_at)의 초 / 60)",
    "actual_minutes_rounding": "실행 기록마다 분 단위 올림 후 합산",
    "cross_midnight_execution": "전체 시간을 시작 시각의 KST 날짜에 귀속하며 날짜별로 분할하지 않음",
    "delayed_task": "due_date < 현재 KST 날짜이고 status가 done 또는 cancelled가 아님",
    "legacy_timestamps": "실제 시각을 모르는 기존 기록에는 임의 시각을 채우지 않음"
  },
  "plan_version_rules": {
    "new_plan": "version 1과 전체 snapshot 자동 저장",
    "update": "updated_at과 version을 제외한 행 내용이 바뀌면 버전 증가 및 새 snapshot 저장",
    "unchanged_update": "내용이 같으면 버전 유지",
    "review_update": "돌아보기와 reviewed_at 변경도 버전 이력에 포함",
    "original_preservation": "계획을 수정해도 이전 snapshot을 수정하지 않음",
    "migration_baseline": "기존 행의 확장 시점 내용을 보존하며 과거 최초 작성 내용이라고 주장하지 않음",
    "delete": "계획 삭제 시 해당 계획의 버전 이력도 삭제"
  },
  "completion_rules": {
    "complete": "할 일 status를 done으로 변경",
    "repeated_complete": "이미 done이면 완료 시각 유지, 완료 집계는 동일 할 일을 한 번만 계산",
    "undo": "status를 todo로 변경하고 completed_at을 NULL로 설정",
    "execution_log_creation": "완료 상태 변경만으로 실행 기록을 생성하지 않음",
    "legacy_done": "기존 done 기록은 completed_at이 NULL일 수 있음"
  },
  "idempotency_rules": {
    "scope": "실행 기록 신규 저장",
    "key": "diary_logs.client_request_id",
    "same_key_same_content": "같은 저장 기록을 반환하며 새 행을 추가하지 않음",
    "same_key_different_content": "409 conflict 반환",
    "content_comparison": [
      "task_id",
      "started_at",
      "ended_at",
      "note",
      "blocked_reason"
    ],
    "concurrent_requests": "DB UNIQUE 제약으로 중복을 막고 기존 기록 재조회",
    "key_update": "PATCH에서 client_request_id 변경 불가",
    "edited_record_replay": "기록이 수정되어 원래 요청 내용과 달라졌다면 원래 POST 재시도는 conflict",
    "deleted_record_replay": "삭제한 기록의 요청 키는 별도 보존하지 않으므로 삭제 후 같은 키로 POST하면 새로 저장될 수 있음"
  },
  "summary_rules": {
    "period_timezone": "Asia/Seoul",
    "period_boundaries": "시작일·종료일 포함",
    "plans": "선택 기간과 시작일~종료일이 겹치는 계획 수",
    "tasks": "마감일이 선택 기간에 포함되는 할 일 수",
    "completed": "위 할 일 중 현재 status가 done인 개수",
    "delayed": "위 할 일 중 현재 마감일이 지났고 done·cancelled가 아닌 개수",
    "blocked": "performed_on이 선택 기간에 포함되고 blocked_reason이 공백 제거 후 비어 있지 않은 실행 기록 수",
    "estimated_minutes": "마감일이 선택 기간에 포함되고 cancelled가 아닌 할 일의 예상 시간 합계",
    "actual_minutes": "performed_on이 선택 기간에 포함되는 모든 실행 기록의 실제 시간 합계",
    "completion_rate": "round(완료 수 / 취소하지 않은 할 일 수 * 100)",
    "zero_denominator": "완료율을 표시하지 않고 —로 표시",
    "historical_state": "과거 시점 상태 복원이 아니라 현재 저장 상태 기준",
    "evidence_navigation": "집계 버튼 → 근거 목록 → 연결된 계획·할 일·실행 기록",
    "time_comparison_note": "기간 집계의 예상 시간과 실제 시간은 귀속 날짜 기준이 다르므로 단순 차이를 같은 작업의 시간 오차로 해석하지 않음"
  },
  "selected_plan_comparison": {
    "plan_estimate": "diary_plans.estimated_minutes",
    "task_estimate": "선택한 계획의 cancelled가 아닌 할 일 예상 시간 합계",
    "actual": "선택한 계획에 연결된 모든 실행 기록 실제 시간 합계",
    "difference_from_plan": "actual - plan_estimate",
    "difference_from_tasks": "actual - task_estimate",
    "task_row_difference": "각 할 일의 actual - estimated_minutes",
    "cancelled_task_rows": "비교표에 표시하지만 예상 합계에서는 제외",
    "period_filter": "상단 기간 필터와 별개로 선택한 계획 전체 기록을 비교"
  },
  "task_search_and_sort": {
    "search": "제목·태그 문자열의 대소문자 구분 없는 부분 일치",
    "filters": [
      "status",
      "priority",
      "tag"
    ],
    "tag_filter": "대소문자 구분 없는 태그 전체 일치",
    "sorts": {
      "manual": "sort_order 오름차순",
      "due_asc": "due_date 오름차순",
      "priority_desc": "high → medium → low",
      "estimated_asc": "estimated_minutes 오름차순",
      "newest": "created_at 내림차순"
    },
    "tie_breaker": "created_at 오름차순, id 오름차순",
    "ui_scope": "선택한 계획의 할 일",
    "summary_isolation": "할 일 검색 결과로 전체 집계 원자료를 교체하지 않음"
  },
  "next_plan_rules": {
    "source": "저장된 이전 계획의 next_action",
    "destination": "새 계획 작성 폼의 goal",
    "relationship": "새 계획의 previous_plan_id",
    "creation": "기간·성공 기준·예상 시간을 입력하고 저장해야 새 계획 생성",
    "button_enabled": "계획이 선택되고 저장된 next_action이 비어 있지 않으며 요청 처리 중이 아닐 때"
  },
  "export": {
    "format": "JSON",
    "format_identifier": "pds-diary-export",
    "schema_version": 2,
    "file_name": "pds-diary-YYYY-MM-DD.json",
    "contents": [
